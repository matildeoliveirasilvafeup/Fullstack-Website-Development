            {% assign value_key_selected = variant_selected[index] %}
            <input
              class="beae-swatch-color-input"
              type="hidden"
              name="beae_option_{{option_index}}"
              value="{{ value_key_selected }}"
              data-option-name="option_{{option_index}}"
              data-option-position="{{option.position}}"
            >
            {% assign option_values = "" %}
            {% for option in variant_selected.options %}
              {% if option != value_key_selected %}
                {% assign option_values = option_values | append: option | append: "," %}
              {% endif %}
            {% endfor %}
            {% assign option_values = option_values | split: "," %}
            {% assign beae_count_variant = 0 %}
            {% for variant in product.variants %}
              {% assign contains_all = true %}
              {% for item in option_values %} 
                {% if variant.options contains item %}
                  {% continue %}
                {% else %}
                  {% assign contains_all = false %}
                  {% break %}
                {% endif %}
              {% endfor %}
              
              {% if contains_all %}
                {% if beae_count_variant <= beae_swatches_max_items %}
                  {% assign value_key = variant.options[option_index] %}
                  {% if beae_swatch_type contains 'color' %}
                    {% assign op = option.values[beae_count_variant] %}
                    <li
                      class="beae-swatch-item beae-swatch-color-item{% if store_colors and store_colors.value[value_key] == blank  %} beae-product-colors--no-color{% endif %}  {% if variant_selected.id == variant.id %}beae-swatch-item-active{% endif %}{% unless product.available %} variant-item-disable{% endunless %}"
                      data-value="{{ variant.options[option_index] }}"
                      data-option-position="{{option.position}}"
                      data-variant-id="{{variant.id}}"
                      {% if source == 'beae' %}
                        {% if store_colors and store_colors.value[value_key] != blank  %} 
                          style="background-color: {{store_colors.value[value_key]}}"
                        {% else %}
                          data-beae-tooltip="Please set the color in settings" 
                        {% endif %}
                        
                      {% else %}
                        {% if op.swatch.image %}
                          style="--beae-swatch-background: url({{ op.swatch.image | image_url: width: 50 }}); {% if op.swatch.image.presentation.focal_point %} --beae-swatch-focal-point: {{ op.swatch.image.presentation.focal_point }};{% endif %}"
                        {% elsif op.swatch.color %}
                          style="--beae-swatch-background: {{ 'rgb(' | append: op.swatch.color.rgb | append: ')' }};"
                        {% endif %}
                      {% endif %}
                    ></li>
                  {% endif %}
                  {% if beae_swatch_type contains 'button' %}
                    <li
                      class="beae-swatch-item beae-swatch-button-item {% if store_colors and store_colors.value[value_key] != blank  %} beae-product-colors--no-color{% endif %}  {% if variant_selected.id == variant.id %}beae-swatch-item-active{% endif %}{% unless product.available %} variant-item-disable{% endunless %}"
                      data-value="{{ variant.options[option_index] }}"
                      data-option-position="{{option.position}}"
                      data-variant-id="{{variant.id}}"
                      {% if store_colors and store_colors.value[value_key] != blank  %} 
                      {% else %} class="beae-product-colors--no-color" 
                      type="button"
                      data-beae-tooltip="Please set the color in settings" 
                      {% endif %}
                    >
                      {{ variant.options[option_index] }}
                    </li>
                  {% endif %}
                  {% if beae_swatch_type contains 'image'  %}
                    <li
                      class="beae-swatch-item beae-watch-image-item beae-product-swatch-item-image {% if variant_selected.id == variant.id %}beae-swatch-item-active{% endif %}{% unless product.available %} variant-item-disable{% endunless %}"
                      data-value="{{ variant.options[option_index] }}"
                      data-option-position="{{option.position}}"
                      data-variant-id="{{variant.id}}"
                    >
                      <img
                        src="{{- variant.image | img_url: crop: 'center' -}}" 
                        alt=" {{ variant[index] }}"
                        height="{% if variant.image.height %}{{ variant.image.height }}{% else %}100{% endif %}"
                        width="{% if variant.image.width %}{{ variant.image.width }}{% else %}100{% endif %}"
                        loading="lazy"
                      />
                    </li>
                  {% endif %}
                {% endif %}
                {% assign beae_count_variant = beae_count_variant | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% if beae_count_variant > beae_swatches_max_items %}
              +{{ beae_count_variant | minus: beae_swatches_max_items }}
            {% endif %}
          </ul>
        {% endif %}
      {% endfor %}
      <select name="variant_id" data-product-id="{{product.id}}" style="display:none;" id="beae-swatch-color-selector-{{product.id}}">
        {% for variant in product.variants %}
          <option value="{{variant.id}}">{{variant.title}}</option>
        {% endfor %}
      </select>
    {% endunless %}
