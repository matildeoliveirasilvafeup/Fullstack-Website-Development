  <script>
    // Clique manual para abrir/fechar perguntas
    document.querySelectorAll('.faq-question').forEach(question => {
      question.addEventListener('click', () => {
        const item = question.parentElement;
        item.classList.toggle('active');
      });
    });

    // Abrir automaticamente a última pergunta ao fazer scroll até ela, com delay de 2 segundos
    const lastFaqItem = document.getElementById('last-faq-item');
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            lastFaqItem.classList.add('active');
          }, 2000); // Atraso de 2 segundos
        }
      });
    }, { threshold: 0.5 });

    observer.observe(lastFaqItem);
  </script>
