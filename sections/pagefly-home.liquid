  <script>
    const carrossel = document.getElementById("carrossel");
    const avaliacoes = carrossel.querySelectorAll(".avaliacao");

    function updateActiveCard() {
      const center = window.innerWidth / 2;
      let closestCard = null;
      let closestDistance = Infinity;

      avaliacoes.forEach(card => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const distance = Math.abs(center - cardCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestCard = card;
        }

        card.classList.remove("active");
      });

      if (closestCard) closestCard.classList.add("active");
    }

    setInterval(updateActiveCard, 200);
  </script>
  <script>
    let isDragging = false;
    let startX;
    let scrollLeft;
    let animationPaused = false;
    const carrosselContainer = document.getElementById("carrossel-container");

    // Parar animação
    function pauseAnimation() {
      carrossel.style.animationPlayState = 'paused';
      animationPaused = true;
    }

    // Retomar animação
    function resumeAnimation() {
      if (animationPaused) {
        carrossel.style.animationPlayState = 'running';
        animationPaused = false;
      }
    }

    // Touch + Mouse drag
    carrosselContainer.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX - carrosselContainer.offsetLeft;
      scrollLeft = carrosselContainer.scrollLeft;
      pauseAnimation(); // Pausa a animação ao começar a arrastar
    });

    // Ao levantar o rato ou dedo (fim do arrasto)
    carrosselContainer.addEventListener('mouseup', () => {
      isDragging = false;
      resumeAnimation(); // Retoma a animação imediatamente
    });

    carrosselContainer.addEventListener('touchend', () => {
      isDragging = false;
      resumeAnimation(); // Retoma a animação imediatamente
    });

    // Se o rato sair do container enquanto arrasta, para de arrastar e retoma após um pequeno delay
    carrosselContainer.addEventListener('mouseleave', () => {
      if (isDragging) { // Só pausa se estivermos a arrastar
        isDragging = false;
        setTimeout(resumeAnimation, 1000); // Dá um pequeno tempo antes de retomar, caso o utilizador volte
      }
    });


    carrosselContainer.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - carrosselContainer.offsetLeft;
      const walk = (x - startX) * 1.5;
      carrosselContainer.scrollLeft = scrollLeft - walk;
    });

    // Suporte a touch
    carrosselContainer.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].pageX - carrosselContainer.offsetLeft;
      scrollLeft = carrosselContainer.scrollLeft;
      pauseAnimation(); // Pausa a animação ao começar a tocar
    });

    carrosselContainer.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const x = e.touches[0].pageX - carrosselContainer.offsetLeft;
      const walk = (x - startX) * 1.5;
      carrosselContainer.scrollLeft = scrollLeft - walk;
    });
  </script>

