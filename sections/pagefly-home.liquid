<html lang="pt">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Layout Corrigido</title>

  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">

  <style>
    /* Estilos Gerais e Reset */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      overflow-x: hidden;
      /* Evita scroll horizontal */
      background: transparent;
      font-family: 'Archivo Black', sans-serif;
    }

    /* Estilos do Bloco Rotativo (principal) */
    #bloco-rotativo {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      position: relative;
      overflow: hidden;
      aspect-ratio: 2304 / 2750;
    }

    #imagem-animada {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-repeat: no-repeat;
      background-position: center center;
      background-size: cover;
      z-index: 0;
      animation: zoom-move 10s ease-in-out infinite;
    }

    @keyframes zoom-move {
      0% {
        transform: scale(1) translateY(0px);
      }

      25% {
        transform: scale(1.05) translateY(-10px);
      }

      50% {
        transform: scale(1.1) translateY(-20px);
      }

      75% {
        transform: scale(1.05) translateY(-10px);
      }

      100% {
        transform: scale(1) translateY(0px);
      }
    }

    .marquee-bar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 30px;
      background: #000;
      color: white;
      overflow: hidden;
      z-index: 1;
      display: flex;
      align-items: center;
      font-family: Arial, sans-serif;
      font-size: 12px;
      font-weight: 900;
    }

    .marquee-content {
      display: flex;
      gap: 60px;
      white-space: nowrap;
      animation: scroll-left 95s linear infinite;
      font-size: 12px;
    }

    .marquee-content span {
      padding: 0 18px;
    }

    @keyframes scroll-left {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-100%);
      }
    }

    #texto-rotativo {
      max-width: 90%;
      position: absolute;
      top: 45%;
      left: 50%;
      transform: translate(-50%, -45%);
      text-align: center;
      color: white;
      font-family: 'Archivo Black', sans-serif;
      font-size: 6vw;
      z-index: 1;
      transition: opacity 1s ease;
    }

    .botao-novidades {
      position: absolute;
      bottom: 8%;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      /* Use flex para centralizar */
      align-items: center;
      justify-content: center;
      /* Centraliza o conteúdo horizontalmente */
      gap: 12px;
      background-color: #FFD600;
      color: #111;
      font-family: 'Archivo Black', sans-serif;
      font-weight: 800;
      font-size: 16px;
      text-transform: uppercase;
      padding: 14px 28px;
      text-decoration: none;
      border-radius: 4px;
      box-shadow: 0 0 6px rgba(0, 0, 0, 0.2);
      z-index: 1;
      transition: all 0.3s ease;
      text-align: center;
    }

    .botao-novidades:hover {
      background-color: #111;
      color: #FFD600;
    }

    .seta {
      font-size: 20px;
      font-weight: bold;
    }

    /* Estilos do Marquee Inferior ("NOVIDADES") */
    .marquee {
      display: flex;
      width: 100vw;
      overflow: hidden;
      background: #2B54C2;
      padding: 5px 0 2px 0;
      box-sizing: border-box;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
      height: 30px;
      font-size: 10px;
      z-index: 1;
      font-family: Arial, sans-serif;
    }

    .marquee__list {
      display: flex;
      white-space: nowrap;
      min-width: 200%;
      animation: marquee-scroll 30s linear infinite;
    }

    .marquee__item {
      display: inline-block;
      padding: 0 10px;
      color: #ffffff;
      font-weight: 600;
      font-size: 15px;
      user-select: none;
    }

    @keyframes marquee-scroll {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-50%);
      }
    }

    /* Estilos da Seção de Categorias */
    .category-section {
      text-align: center;
      margin-top: 40px;
      /* Aumenta o espaçamento superior */
      margin-bottom: 20px;
    }

    .category-title {
      font-family: 'Poppins', sans-serif;
      font-size: 36px;
      font-weight: 700;
      color: #2B54C2;
      letter-spacing: 0;
      text-transform: uppercase;
      line-height: 1.2;
      margin-bottom: 10px;
    }

    .view-all-link {
      display: inline-block;
      font-size: 16px;
      color: #232323;
      text-decoration: none;
      margin-top: 10px;
      font-weight: 400;
    }

    .view-all-link::after {
      content: "";
      display: block;
      width: 50px;
      height: 2px;
      background: #232323;
      margin: 10px auto 0;
    }

    .categorias-section {
      position: relative;
      width: 100vw;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
      overflow-x: hidden;
      padding-top: 10px;
      background: #fff;
    }

    .categorias-carousel {
      padding-left: 0;
      margin-left: 0;
      display: flex;
      overflow-x: auto;
      scroll-behavior: smooth;
    }

    /* Esconde scrollbar */
    .categorias-carousel::-webkit-scrollbar {
      display: none;
    }

    .categorias-carousel {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .categoria-item {
      position: relative;
      flex: 0 0 390px;
      height: 430px;
      overflow: hidden;
      cursor: pointer;
      margin: 0;
      padding: 0;
      border-radius: 0;
      text-decoration: none;
      background: #000;
    }

    .categoria-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
      border-radius: 0;
    }

    .categoria-item:hover .categoria-img {
      transform: scale(1.12);
    }

    .categoria-texto {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #FFCC00;
      /* Cor amarela para o texto das categorias */
      font-family: 'Archivo Black', sans-serif;
      font-size: 60px;
      font-weight: 900;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      text-shadow: 0 0 5px rgba(0, 0, 0, 0.7);
      pointer-events: none;
      z-index: 2;
    }

    /* Estilos da Barra de Logos */
    .logo-bar {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      justify-items: center;
      align-items: center;
      margin: 0;
      padding-top: 0px;
      padding-bottom: 20px;
      max-width: 100%;
      position: relative;
      z-index: 0;
      background: transparent;
      margin-top: 10px;
      /* Adiciona margem acima da barra de logos */
    }

    .brand-logo {
      width: 100%;
      height: auto;
      object-fit: contain;
      transition: transform 0.3s ease;
      background: transparent;
    }

    .brand-logo:hover {
      transform: scale(1.1);
    }

    /* Estilos do Full Banner */
    .full-banner-wrapper {
      position: relative;
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(-50vw + 50%);
      overflow: hidden;
      padding-top: 10px;
    }

    .full-banner-bg {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      padding-top: 10px;
    }

    .full-banner-bg.mobile {
      display: none;
      padding-bottom: 10px;
      padding-top: 20px;
    }

    .fade-top,
    .fade-bottom {
      position: absolute;
      width: 100%;
      height: 60px;
      z-index: 1;
      pointer-events: none;
    }

    .fade-top {
      top: 40px;
      background: linear-gradient(to bottom, white, transparent);
    }

    .fade-bottom {
      bottom: 0;
      background: linear-gradient(to top, white, transparent);
    }

    .full-banner-btn-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      text-align: center;
      padding-top: 10px;
    }

    .full-banner-btn {
      padding: 18px 50px;
      background: #f9cd41;
      color: black;
      text-decoration: none;
      font-size: 1.6rem;
      font-weight: bold;
      border: 2px solid #007bff;
      border-radius: 8px;
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
      display: inline-block;
    }

    /* Media Queries (Responsividade) */
    @media (max-width: 1024px) {
      .fundo-escuro-mobile {
        padding-top: 0 !important;
      }

      #texto-rotativo {
        font-size: clamp(30px, 6vw, 40px);
        line-height: 1.2;
      }

      .botao-novidades {
        font-size: 12px;
        padding: 10px 20px;
        gap: 8px;
      }

      .seta {
        font-size: 16px;
      }

      .marquee__item {
        padding: 0 8px;
        font-size: 15px;
      }

      .marquee {
        height: 30px;
      }

      .category-section {
        margin-top: 25px;
      }

      /* Ajuste de margem para mobile */
      .category-title {
        font-size: 28px;
      }

      .view-all-link {
        font-size: 14px;
      }

      .categorias-titulo {
        font-size: 32px;
      }

      .categorias-carousel {
        gap: 0px;
        padding-left: 0px;
      }

      .categoria-item {
        flex: 0 0 390px;
        height: 450px;
      }

      .categoria-texto {
        font-size: 60px;
      }

      .full-banner-bg.desktop {
        display: none;
      }

      .full-banner-bg.mobile {
        display: block;
      }

      .full-banner-btn {
        padding: 12px 30px;
        font-size: 1.2rem;
        white-space: normal;
        line-height: 1.4;
      }

      .full-banner-btn-container {
        width: 90%;
        top: 50%;
        transform: translate(-50%, -50%);
      }

      .fade-top,
      .fade-bottom {
        display: none;
      }

      .brand-logo {
        max-width: 80px;
      }

      .logo-bar {
        z-index: 2;
        background: transparent;
      }
    }

    @media (min-width: 769px) {
      .full-banner-wrapper {
        padding-top: 0;
      }

      .fade-top {
        top: 0;
      }

      .full-banner-btn-container {
        top: calc(50% + 100px);
      }

      .brand-logo {
        max-width: 140px !important;
      }
    }
  </style>
</head>

