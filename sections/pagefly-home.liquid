      imagem: 'https://cdn.shopify.com/s/files/1/0910/9520/4214/files/IMG_7855_black.jpg?v=1749251806'
    }
  ];

  let i = 0;
  const texto = document.getElementById("texto-rotativo");
  const imagemAnimada = document.getElementById("imagem-animada");

  if (texto && imagemAnimada) {
      // Define a imagem inicial e texto para evitar um 'flash' vazio
      imagemAnimada.style.backgroundImage = `url('${frases[0].imagem}')`;
      texto.innerHTML = frases[0].texto;

      setInterval(() => {
        texto.style.opacity = 0;
        setTimeout(() => {
          i = (i + 1) % frases.length;
          imagemAnimada.style.backgroundImage = `url('${frases[i].imagem}')`;
          texto.innerHTML = frases[i].texto;
          texto.style.opacity = 1;
        }, 800);
      }, 3000);
  }
  
  // Script para o scroll automático do carrossel de categorias (mobile)
  if (window.innerWidth <= 768) {
    const carousel = document.querySelector('.categorias-carousel');
    
    if (carousel) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              carousel.scrollBy({ left: 250, behavior: 'smooth' }); // Scroll para a direita
              setTimeout(() => {
                carousel.scrollBy({ left: -250, behavior: 'smooth' }); // Scroll de volta para a esquerda
              }, 1000);
            }
          });
        },
        {
          root: null,
          threshold: 0.3
        }
      );
      observer.observe(carousel);
    }
  }
  </script>

