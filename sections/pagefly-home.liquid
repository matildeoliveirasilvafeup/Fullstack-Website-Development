<script>
  function toggleDropdown(el) {
    const component = el.closest('.meu-componente-customizado');
    const options = component.querySelector('.quantia-options');
    const allComponents = document.querySelectorAll('.meu-componente-customizado');

    const wasActive = options.classList.contains('active');

    allComponents.forEach(comp => {
      const openOptions = comp.querySelector('.quantia-options');
      openOptions.classList.remove('active');
      comp.classList.remove('active-dropdown');
    });

    if (!wasActive) {
      options.classList.add('active');
      component.classList.add('active-dropdown');
    }
  }

  document.addEventListener('click', function(event) {
    document.querySelectorAll('.meu-componente-customizado').forEach(component => {
      const dropdownOptions = component.querySelector('.quantia-options');
      if (dropdownOptions && !component.contains(event.target)) {
        dropdownOptions.classList.remove('active');
        component.classList.remove('active-dropdown');
      }
    });
  });

  window.addEventListener('scroll', function() {
    document.querySelectorAll('.quantia-options.active').forEach(openDropdown => {
      openDropdown.classList.remove('active');
      const component = openDropdown.closest('.meu-componente-customizado');
      if (component) {
        component.classList.remove('active-dropdown');
      }
    });
  });

  function selecionarQuantia(botao, event) {
    event.stopPropagation();
    
    const container = botao.closest('.meu-componente-customizado');
    if (!container) return;
    
    const fullText = botao.textContent.trim();
    const matchPrice = fullText.match(/\(€.*\)/);
    const title = fullText.split(' (€')[0];
    const priceText = matchPrice ? matchPrice[0].replace(/[()]/g, '') : '';
    
    const selecionadaSpan = container.querySelector('.quantia-selecionada');
    if (selecionadaSpan) {
      selecionadaSpan.textContent = title;
    }

    const precoInfo = container.querySelector('.preco-info');
    if (precoInfo) {
      precoInfo.textContent = priceText;
    }

    const botaoCarrinho = container.querySelector('.add-cart');
    if (botaoCarrinho) {
      botaoCarrinho.setAttribute('data-variant-id', botao.getAttribute('data-variant-id'));
    }

    const optionsDropdown = container.querySelector('.quantia-options');
    if (optionsDropdown) {
      optionsDropdown.classList.remove('active');
      container.classList.remove('active-dropdown');
    }
  }

  function tratarCliqueCarrinho(botao, event) {
    event.preventDefault();

    const variantId = botao.getAttribute('data-variant-id');

    if (!variantId) {
      alert("Seleciona uma quantia antes de adicionar ao carrinho.");
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/cart/add';

    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'id';
    input.value = variantId;

    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }
