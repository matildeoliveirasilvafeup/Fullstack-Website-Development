<!-- Container central para todo o conteúdo -->
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 15px; font-family: sans-serif;">
  <div style="display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between;">
     <div class="product-flex-wrapper" style="display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between;">
    <!-- Coluna Esquerda: Imagem principal + miniaturas -->
    <div style="flex: 1 1 48%; max-width: 48%;">
      <!-- Imagem Principal -->
      <img id="main-product-image" src="{{ product.featured_image | image_url: width: 450 }}" style="width: 100%; border-radius: 12px;">
      
      <!-- Galeria de Miniaturas -->
      <div style="display: flex; gap: 10px; margin-top: 10px;">
        {% for image in product.images %}
          <img class="thumbnail {% if forloop.first %}active{% endif %}" src="{{ image | image_url: width: 450 }}" onclick="changeImage(this);" style="width: 70px; cursor: pointer; border-radius: 6px;">
        {% endfor %}
        
        <!-- Imagens adicionais específicas -->
        <img class="thumbnail" src="https://cdn.shopify.com/s/files/1/0910/9520/4214/files/combo.jpg?v=1745593662&width=450" onclick="changeImage(this);" style="width: 70px; cursor: pointer; border-radius: 6px;">
        <img class="thumbnail" src="https://cdn.shopify.com/s/files/1/0910/9520/4214/files/calcas.jpg?v=1744306153&width=450" onclick="changeImage(this);" style="width: 70px; cursor: pointer; border-radius: 6px;">
      </div>
    </div>

    <!-- Coluna Direita: Info do produto + bundle -->
    <div style="flex: 1 1 48%; max-width: 48%; padding: 10px;">
      <h1 style="font-size: 32px; font-weight: 700; margin-top: -20px; margin-bottom: 10px;">{{ product.title }}</h1>

      <form method="post" action="/cart/add">
        <input type="hidden" name="id" id="variant-id">

        <!-- Adicionar seletor de quantidade -->
        <label for="quantity-select" style="font-weight: bold;">Escolher quantidade:</label><br>
        <select id="quantity-select" style="width: 100%; padding: 18px; font-size: 20px; margin: 15px 0; border-radius: 6px; border: 1px solid #ccc;">
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
        </select>

        <p style="font-size: 24px; font-weight: bold;">Total: <span id="bundle-price">{{ product.variants.first.price | money }}</span></p>



        <button type="submit" style="background-color: #facc15; color: #000; padding: 18px 32px; font-size: 18px; border-radius: 12px; font-weight: bold; text-transform: uppercase; width: 100%; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
          Adicionar ao carrinho
        </button>
      </form>

      <ul style="list-style: none; padding-left: 0; font-size: 16px; line-height: 1.6; margin-top: 20px;">
        <li>✅ Peças revisadas 1 a 1 pelos nossos especialistas</li>
        <li>✅ Ganhe até 150% por peça</li>
        <li>✅ Ideal para revenda na Vinted</li>
        <li>✅ Envio rápido em toda Europa</li>
      </ul>

      <!-- Acordeão -->
      <div style="margin-top: 30px;">
        {% assign sections = 
          "📦 DESCRIÇÃO DO PRODUTO:Esta box contém peças únicas, vintage e rework, prontas para revenda.|🚚 ENTREGA:Entrega rápida: 24–72h em PT/ES, até 7 dias úteis na Europa.|🧥 ARTIGOS:Peças em Grau A, com até 9% em Grau B por erro humano.|ℹ️ INFORMAÇÕES ADICIONAIS:Tamanhos e modelos aleatórios. Imagens são ilustrativas." 
          | split: "|" %}

        {% for section in sections %}
          {% assign pair = section | split: ":" %}
          <div class="accordion">
            <div class="accordion-title">
              <span>{{ pair[0] }}</span>
              <span class="accordion-icon">
                <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 0 24 24" width="20"><path d="M7 10l5 5 5-5z"/></svg>
              </span>
            </div>
            <div class="accordion-content">
              {{ pair[1] }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Secção Vinted Academy -->
  <div style="width: 100%; background-color: #fef3c7; padding: 40px; border-radius: 16px; margin-top: 40px;">
    <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;">
      <span style="background-color: #fde047; color: #000; padding: 6px 16px; border-radius: 9999px; font-weight: bold; font-size: 14px;">🚀 3X SUAS VENDAS NA VINTED</span>
      <span style="background-color: #60a5fa; color: white; padding: 6px 16px; border-radius: 9999px; font-weight: bold; font-size: 14px;">🔥 100% GRÁTIS</span>
    </div>

    <h3 style="font-size: 22px; font-weight: bold; margin-bottom: 10px;">Torne-se um Vendedor Profissional Vinted GRATUITAMENTE e gere mais de €1.200 em menos de 30 dias.</h3>
    <p style="font-size: 16px; margin-bottom: 20px;">
      Com a compra de qualquer pacote de roupas do site, você terá acesso gratuito ao treinamento da <strong>Vinted Academy 2.0</strong>.
    </p>

    <p style="font-size: 16px; margin-bottom: 10px;">Aprenda a:</p>
    <ul style="font-size: 16px; line-height: 1.6; padding-left: 20px;">
      <li>✅ Otimize seu perfil Vinted</li>
      <li>✅ Comprar mercadorias - Fornecedores</li>
      <li>✅ Encontre produtos vencedores</li>
      <li>✅ Tire fotos vencedoras</li>
      <li>✅ Escreva descrições vencedoras</li>
      <li>✅ Estabeleça preços vencedores</li>
      <li>✅ <strong>BÔNUS:</strong> Aprenda as Técnicas Secretas</li>
    </ul>
  </div>
</div>

<!-- Script JS -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
  const quantitySelect = document.getElementById('quantity-select');
  const bundlePrice = document.getElementById('bundle-price');
  const variantId = document.getElementById('variant-id');
  const pricePerUnit = parseFloat("{{ product.variants.first.price | money_without_currency }}"); // preço unitário do produto

  const updatePrice = () => {
    const quantity = parseInt(quantitySelect.value); // pega a quantidade escolhida
    const totalPrice = pricePerUnit * quantity; // calcula o total
    bundlePrice.innerHTML = "{{ product.price | money }}".replace(/(\d+)(?=\.\d{2})/, totalPrice.toFixed(2)); // Atualiza o total no preço
    variantId.value = "{{ product.variants.first.id }}"; // mantém o id da variante
  };

  // Atualizar o preço sempre que a quantidade mudar
  quantitySelect.addEventListener('change', updatePrice);

  updatePrice(); // chama a função uma vez ao carregar a página para definir o preço inicial
});

  function changeImage(imgElement) {
    const mainImg = document.getElementById('main-product-image');
    mainImg.src = imgElement.src;

    document.querySelectorAll('.thumbnail').forEach(thumb => {
      thumb.classList.remove('active');
    });

    imgElement.classList.add('active');
  }

  document.querySelectorAll('.accordion').forEach(accordion => {
    accordion.addEventListener('click', function () {
      const content = this.querySelector('.accordion-content');
      const icon = this.querySelector('.accordion-icon svg');

      if (this.classList.contains('open')) {
        this.classList.remove('open');
        content.style.maxHeight = null;
        icon.style.transform = 'rotate(0deg)';
      } else {
        this.classList.add('open');
        content.style.maxHeight = content.scrollHeight + "px";
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  const bundleSelect = document.getElementById('bundle-select');
  const quantitySelect = document.getElementById('quantity-select');
  const bundlePrice = document.getElementById('bundle-price');
  const variantId = document.getElementById('variant-id');

  if (bundleSelect && quantitySelect) {
    const updatePrice = () => {
      const selected = bundleSelect.options[bundleSelect.selectedIndex];
      const quantity = quantitySelect.value;
      const totalPrice = parseFloat(selected.dataset.price) * quantity;
      variantId.value = selected.dataset.variant;
    };
    
    bundleSelect.addEventListener('change', updatePrice);
    quantitySelect.addEventListener('change', updatePrice);
    
    updatePrice();
  }
</script>

<!-- Estilos -->
<style>
  .thumbnail {
    width: 70px;
    border: 2px solid #1e293b;
    border-radius: 6px;
    cursor: pointer;
    transition: border 0.2s ease;
  }

  .thumbnail.active {
    border: 4px solid #1e293b;
  }

  .accordion {
    border: 1px solid #ddd;
    border-radius: 10px;
    margin-top: 20px;
    background-color: #fafafa;
    cursor: pointer;
    padding: 15px 20px;
    transition: background-color 0.2s ease;
  }

  .accordion.open {
    background-color: #fffde0;
    border-color: #facc15;
  }

  .accordion-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    font-size: 17px;
  }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    font-size: 16px;
    line-height: 1.6;
    padding-left: 5px;
  }

  .accordion-icon svg {
    transition: transform 0.3s ease;
    fill: black;
  }

  @media (max-width: 768px) {
    div[style*="display: flex; flex-wrap: wrap;"] > div {
      flex: 1 1 100% !important;
      max-width: 100% !important;
    }
  }
</style>
<style>
@media (max-width: 1024px) {
  /* Alinha todo o conteúdo no centro */
  .product-flex-wrapper {
    justify-content: center !important;
  }

  /* Faz as colunas ficarem em bloco, uma em cima da outra */
  .product-flex-wrapper > div {
    max-width: 100% !important;
    flex: 1 1 100% !important;
  }
}
</style>   
