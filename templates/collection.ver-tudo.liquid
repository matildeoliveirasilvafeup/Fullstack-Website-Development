  <h2 class="section-title">{{ collection.title }}</h2>

  <div class="product-slider-wrapper">
    <button class="arrow-btn arrow-left" onclick="scrollProductSlider(-1)" aria-label="Scroll Left">‹</button>

    <div class="product-slider" id="product-slider">
      {% assign handles = "dickies-by-kilos,carhartt-by-kilos,ralph-lauren-by-kilos,mix-carhartt-rework,casacos-de-couro-vintage,casacos-dickies-1,mix-carhartt-dickies-calcas,calcas-carhartt,calcas-dickies,vintage-t-shirts,polos-tommy-hilfiger,polos-lacoste,polos-ralph-lauren,polo-ralph-tee,vintage-sweaters,pullover-tommy-hilfiger,mix-blazers-de-marca,combo-i,combo-ii,combo-iii" | split: "," %}
      {% for handle in handles %}
        {% assign product = all_products[handle] %}
        {% assign base_price = product.price %}
        {% assign price_with_markup = base_price | times: 1.05 | round %}

