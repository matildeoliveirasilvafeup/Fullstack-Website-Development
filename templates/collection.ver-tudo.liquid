<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>DROPLAWI</title>
  <style>
    body {
      margin: 0;
    }

    /* MARQUEE - faixa preta com texto em movimento */
    .marquee-bar {
      width: 100%;
      height: 35px;
      background-color: #000;
      color: white;
      overflow: hidden;
      z-index: 1000;
      display: flex;
      align-items: center;
      font-family: Arial, sans-serif;
      font-size: 14px;
      font-weight: 900;
      margin: 0;
      padding: 0;
    }

    .marquee-content {
      display: flex;
      white-space: nowrap;
      gap: 60px;
      animation: scroll-left 50s linear infinite;
    }

    .marquee-content span {
      padding: 0 18px;
    }

    @keyframes scroll-left {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-100%);
      }
    }

    .section-title {
      font-family: inherit; /* usa a fonte padrão */
      font-weight: normal;  /* ou 400, o normal */
      font-size: 45px;      /* mantém tamanho */
      padding: 0 10px;
      color: #222222;        /* cor um pouco mais escura que preto suave */
      text-shadow: none;    /* remove sombra */
      margin: 15px 0 20px;
      text-transform: none;
      position: relative;
      padding-left: 80px;
    }

    .product-slider-wrapper {
      position: relative;
    }

    /* Setas de navegação visíveis por padrão (para PC/iPad) */
    .arrow-btn {
      display: block; /* Garante que sejam visíveis fora do mobile */
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: white;
      border: none;
      font-size: 2rem;
      z-index: 1;
      cursor: pointer;
      opacity: 0.8;
      padding: 0.4rem 0.6rem;
      border-radius: 50%;
      box-shadow: 0 2px 5px rgba(0,0,0,0.3);
      user-select: none;
    }
    .arrow-left {
      left: 4px;
    }
    .arrow-right {
      right: 4px;
    }

    .product-slider {
      display: flex;
      flex-wrap: wrap; /* Permite que os itens quebrem para a próxima linha em telas maiores */
      justify-content: center;
      gap: 1.5rem;
      padding: 0;
      /* Por padrão, permite quebra de linha para visualização em grid em telas maiores */
    }

    /* Media query para modo telefone (max-width: 768px) */
    @media (max-width: 768px) {
      .section-title {
        text-align: center; /* **Centra o texto horizontalmente** */
        padding-left: 0;   /* **Remove o padding à esquerda** que o empurrava */
        font-size: 42px;   /* Opcional: Ajusta o tamanho da fonte para melhor visualização em telemóveis */
      }
      .arrow-btn {
        display: none; /* Oculta as setas em modo telefone */
      }
      .product-slider {
        flex-wrap: nowrap; /* Desativa a quebra de linha para o scroll horizontal (se queres horizontal em tablet, mas o pedido é vertical em telefone) */
        overflow-x: hidden; /* Remove scroll horizontal em modo telefone */
        overflow-y: auto; /* Adiciona scroll vertical em modo telefone */
        flex-direction: column; /* Organiza os itens em uma coluna */
        align-items: center; /* Centraliza os itens na coluna */
        scroll-snap-type: y mandatory; /* Opcional: para o scroll com "snap" */
        -webkit-overflow-scrolling: touch;
        -ms-overflow-style: none; /* Oculta scrollbar para IE/Edge */
        scrollbar-width: none; /* Oculta scrollbar para Firefox */
      }
      .product-slider::-webkit-scrollbar {
        display: none; /* Oculta scrollbar para Webkit browsers */
      }
      .product-card {
        scroll-snap-align: start; /* Opcional: para o scroll com "snap" */
        width: 90%; /* Ajusta a largura do cartão para ser responsiva no telefone */
        max-width: 300px; /* Mantém uma largura máxima para o cartão no telefone */
      }
    }

    /* Regras globais (fora das media queries) */
    :root {
      --font-heading-family: "Futura", sans-serif;
      --font-heading-weight: 600;
      --product-card-shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
      --product-card-corner-radius: 0.8rem;
      --button-blue: #006AFF;
      --grey-background: #f5f5f5;
      --discount-red: #e60023;
    }

    .product-card {
      width: 300px;
      border-radius: var(--product-card-corner-radius);
      overflow: hidden;
      box-shadow: var(--product-card-shadow);
      background-color: white;
      font-family: var(--font-heading-family);
      position: relative;
      transition: transform 0.3s ease;
      flex: 0 0 auto; /* Importante para o layout flex */
    }

    .product-card:hover {
      transform: scale(1.03);
    }

    .product-image-container img {
      width: 100%;
      display: block;
    }

    .badge-best-seller {
      position: absolute;
      top: 10px;
      right: 10px;
      background: #007bff;
      color: white;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 6px 10px;
      border-radius: 50px;
      z-index: 2;
    }

    .product-info {
      background: var(--grey-background);
      padding: 16px;
      text-align: center;
    }

    .product-title {
      font-weight: var(--font-heading-weight);
      font-size: 1rem;
      margin-bottom: 8px;
    }

    .product-stars {
      color: #f5c518;
      font-size: 0.9rem;
    }

    .product-reviews {
      font-size: 0.85rem;
      color: #333;
    }

    .price-section {
      margin-top: 8px;
      font-size: 0.95rem;
    }

    .old-price {
      text-decoration: line-through;
      color: gray;
      margin-right: 6px;
    }

    .new-price {
      color: var(--discount-red);
      font-weight: bold;
    }

    .choose-options-button {
      margin-top: 16px;
      background-color: var(--button-blue);
      color: white;
      border: none;
      padding: 12px;
      font-weight: bold;
      font-size: 0.95rem;
      border-radius: 8px;
      width: 100%;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background-color 0.3s ease;
    }

    .choose-options-button:hover {
      background-color: #004fcf;
    }
  </style>
</head>
