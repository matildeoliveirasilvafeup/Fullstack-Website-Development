            {% assign reviews_count = 112 %}
            {% assign star_rating = 5 %}
          {% when "dickies-by-kilos" %}
            {% assign reviews_count = 87 %}
            {% assign star_rating = 4 %}
          {% when "carhartt-by-kilos" %}
            {% assign reviews_count = 65 %}
            {% assign star_rating = 5 %}
          {% when "ralph-lauren-by-kilos" %}
            {% assign reviews_count = 41 %}
            {% assign star_rating = 4 %}
          {% when "casacos-de-couro-vintage" %}
            {% assign reviews_count = 78 %}
            {% assign star_rating = 5 %}
          {% when "casacos-dickies-1" %}
            {% assign reviews_count = 59 %}
            {% assign star_rating = 4 %}
          {% when "mix-carhartt-dickies-calcas" %}
            {% assign reviews_count = 75 %}
            {% assign star_rating = 4 %}
          {% when "calcas-carhartt" %}
            {% assign reviews_count = 89 %}
            {% assign star_rating = 5 %}
          {% when "calcas-dickies" %}
            {% assign reviews_count = 52 %}
            {% assign star_rating = 4 %}
          {% when "vintage-t-shirts" %}
            {% assign reviews_count = 26 %}
            {% assign star_rating = 4 %}
          {% when "polos-tommy-hilfiger" %}
            {% assign reviews_count = 38 %}
            {% assign star_rating = 4 %}
          {% when "polos-lacoste" %}
            {% assign reviews_count = 28 %}
            {% assign star_rating = 4 %}
          {% when "polos-ralph-lauren" %}
            {% assign reviews_count = 45 %}
            {% assign star_rating = 5 %}
          {% when "polo-ralph-tee" %}
            {% assign reviews_count = 54 %}
            {% assign star_rating = 5 %}
          {% when "vintage-sweaters" %}
            {% assign reviews_count = 62 %}
            {% assign star_rating = 4 %}
          {% when "pullover-tommy-hilfiger" %}
            {% assign reviews_count = 70 %}
            {% assign star_rating = 5 %}
          {% when "mix-blazers-de-marca" %}
            {% assign reviews_count = 30 %}
            {% assign star_rating = 4 %}
          {% when "combo-i" %}
            {% assign reviews_count = 15 %} 
            {% assign star_rating = 5 %} 
          {% when "combo-ii" %}
            {% assign reviews_count = 20 %} 
            {% assign star_rating = 5 %} 
          {% when "combo-iii" %}
            {% assign reviews_count = 18 %} 
            {% assign star_rating = 4 %}
          {% else %}
            {% assign reviews_count = 30 %}
            {% assign star_rating = 4 %}
        {% endcase %}

        <div class="product-card">
          <div class="product-image-container">
            <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}" />
            {% if product.tags contains "bestseller" %}
              <div class="badge-best-seller">BEST SELLER</div>
            {% endif %}
          </div>

          <div class="product-info">
            <div class="product-title">{{ product.title }}</div>
            <div class="product-stars">
              {% for i in (1..5) %}
                {% if i <= star_rating %}
                  ★
                {% else %}
                  ☆
                {% endif %}
              {% endfor %}
              <span class="product-reviews">({{ reviews_count }})</span>
            </div>
            <div class="price-section">
              <span class="old-price">{{ price_with_markup | money }}</span>
              <span class="new-price">{{ base_price | money }}</span>
            </div>
            <a href="{{ product.url }}" class="choose-options-button">ESCOLHE A OPÇÃO</a>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="arrow-btn arrow-right" onclick="scrollProductSlider(1)" aria-label="Scroll Right">›</button>
  </div>

  <script>
    function scrollProductSlider(direction) {
      const slider = document.getElementById("product-slider");
      const scrollAmount = slider.offsetWidth * 0.8;
      slider.scrollBy({
        left: direction * scrollAmount,
        behavior: "smooth"
      });
    }

    // Código para garantir que o slider comece no início ao carregar a página
    document.addEventListener('DOMContentLoaded', function() {
        const productSlider = document.getElementById('product-slider');
        if (productSlider) {
            // Força o scroll do carrossel para o início (posição 0)
            productSlider.scrollLeft = 0;
        }
    });
  </script>
