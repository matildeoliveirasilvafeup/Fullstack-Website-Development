<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
 body {
  margin: 0;
  font-family: "Inter", sans-serif;
  background: #f8f8f8;
  color: #222;
  line-height: 1.6;
}

  a {
    color: #f6b91b;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .container {
    max-width: 1100px;
    margin: 40px auto;
    background: white;
    border-radius: 20px;
    box-shadow: 0 6px 18px rgb(246 185 27 / 0.15);
    display: flex;
    gap: 40px;
    padding: 40px;
  }
  /* Esquerda: galeria + imagem principal */
  .left-column {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .main-image {
    width: 100%;
    border-radius: 20px;
    box-shadow: 0 6px 15px rgb(246 185 27 / 0.35);
    object-fit: contain;
    max-height: 480px;
  }
  .gallery {
    display: flex;
    gap: 16px;
    overflow-x: auto;
  }
  .gallery img {
    width: 80px;
    height: 80px;
    border-radius: 14px;
    cursor: pointer;
    border: 3px solid transparent;
    object-fit: cover;
    flex-shrink: 0;
    transition: border-color 0.3s ease;
  }
  .gallery img.active {
    border-color: #f6b91b;
  }

  /* Direita: título, botão, preço, accordions, e conteúdo adicional */
  .right-column {
    flex: 0 0 55%;
    display: flex;
    flex-direction: column;
  }
  .product-title {
    font-weight: 900;
    font-size: 3rem;
    margin: 0 0 12px 0;
    color: #222;
  }
  .product-subtitle {
    font-weight: 400;
    font-size: 1.3rem;
    margin: 0 0 36px 0;
    color: #555;
  }
  .btn-primary {
    background-color: #f6b91b;
    color: #222;
    border: none;
    border-radius: 16px;
    font-size: 1.4rem;
    padding: 18px 0;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.05em;
    box-shadow: 0 6px 18px rgb(246 185 27 / 0.45);
    margin-bottom: 32px;
    width: 100%;
    transition: background-color 0.3s ease;
  }
  .btn-primary:hover {
    background-color: #d8a917;
  }
  .price-box {
    background: #fff3cd;
    color: #856404;
    padding: 22px 28px;
    border-radius: 16px;
    font-size: 1.9rem;
    font-weight: 700;
    margin-bottom: 50px;
    text-align: center;
    box-shadow: 0 6px 15px rgb(246 185 27 / 0.35);
  }

  /* Accordion */
  .accordion {
  border-top: 1px solid #eee;
  width: 100%;
  max-width: 100%;
  margin: 0 auto 40px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.accordion-item {
  width: 100%;
  max-width: 700px; /* ou outro valor que aches adequado */
}

  .accordion-header {
    background: #fff8e1;
    cursor: pointer;
    padding: 20px 24px;
    font-weight: 700;
    font-size: 1.3rem;
    user-select: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #a67c00;
    letter-spacing: 0.03em;
  }
  .accordion-header:hover {
    background: #fff2c2;
  }
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    padding: 0 24px;
    transition: max-height 0.3s ease, padding 0.3s ease;
    background: #fffde7;
    color: #5c5c5c;
    font-size: 1rem;
    line-height: 1.5;
  }
  .accordion-content.open {
    padding: 20px 24px;
    max-height: 700px;
  }
  .accordion-arrow {
    transition: transform 0.3s ease;
    font-size: 1.7rem;
    color: #f6b91b;
  }
  .accordion-arrow.open {
    transform: rotate(90deg);
  }

  /* Secções adicionais para preencher até às reviews */
  .product-description {
    margin-top: 2rem; /* ou 20px, ou qualquer valor que preferires */
    font-size: 1.1rem;
    color: #444;
    line-height: 1.5;
    margin-bottom: 40px;
  }
  .additional-info {
    background: #fff8e1;
    border-radius: 16px;
    padding: 30px 24px;
    color: #6f5400;
    font-size: 1.15rem;
    box-shadow: 0 4px 12px rgb(246 185 27 / 0.2);
    margin-bottom: 40px;
  }
  .additional-info h3 {
    margin-top: 0;
    margin-bottom: 12px;
    font-weight: 700;
  }

  /* Responsividade */
  @media (max-width: 920px) {
    .container {
      flex-direction: column;
      padding: 20px;
      margin: 20px auto;
    }
    .left-column, .right-column {
      flex: none;
      width: 100%;
    }
    .steps {
      flex-direction: column;
      gap: 20px;
    }
    .step {
      align-items: center;
      text-align: center;
    }
    .step-text {
      color: #444;
    }
  }
</style>
