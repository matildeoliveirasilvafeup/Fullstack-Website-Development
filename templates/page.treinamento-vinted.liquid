  <script>
  // Accordion open/close - só 1 aberto de cada vez
  document.querySelectorAll('.accordion-header').forEach(header => {
    header.addEventListener('click', () => {
      const currentlyOpen = document.querySelector('.accordion-content.open');
      const currentlyArrow = document.querySelector('.accordion-arrow.open');
      const content = header.nextElementSibling;
      const arrow = header.querySelector('.accordion-arrow');

      if (currentlyOpen && currentlyOpen !== content) {
        currentlyOpen.classList.remove('open');
        currentlyOpen.style.maxHeight = null;
        if (currentlyArrow) currentlyArrow.classList.remove('open');
      }

      content.classList.toggle('open');
      arrow.classList.toggle('open');

      if (content.classList.contains('open')) {
        content.style.maxHeight = content.scrollHeight + "px";
      } else {
        content.style.maxHeight = null;
      }
    });
  });
</script>



